{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/es/",
        "http://localhost:4321/bitacora/",
        "http://localhost:4321/es/bitacora/",
        "http://localhost:4321/about/",
        "http://localhost:4321/es/about/",
        "http://localhost:4321/bitacora/orphan-gpu-reconciler/",
        "http://localhost:4321/es/bitacora/orphan-gpu-reconciler/",
        "http://localhost:4321/bitacora/mcp-write-reported-success/",
        "http://localhost:4321/es/bitacora/mcp-write-reported-success/",
        "http://localhost:4321/work/project-brain/",
        "http://localhost:4321/es/work/project-brain/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "interactive": ["error", { "maxNumericValue": 3000 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 307200 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 102400 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 512000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouse"
    }
  }
}
