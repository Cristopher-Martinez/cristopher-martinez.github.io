# Cloudflare Pages reads this file from the build output root.
#
# Everything under /_astro/ carries a content hash in its filename, so the URL
# changes whenever the bytes do. That makes the response safe to cache forever:
# a stale copy can never be served, because a changed file is a different URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML has stable URLs, so it must revalidate or a deploy would not reach
# anyone still holding a cached page.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
