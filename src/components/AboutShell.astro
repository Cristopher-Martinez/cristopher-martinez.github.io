---
interface Props {
  heading: string;
  lede: string;
}

const { heading, lede } = Astro.props;
---

<main id="content" class="wrap about">
  <header>
    <p class="label">{heading}</p>
    <h1>Cristopher Martinez</h1>
    <p class="lede muted">{lede}</p>
  </header>

  <div class="prose">
    <slot />
  </div>
</main>

<style>
  .about {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-start: var(--space-xs);
  }

  .lede {
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 54ch;
    margin-block-start: var(--space-s);
  }

  .prose {
    margin-block-start: var(--space-l);
  }
</style>
