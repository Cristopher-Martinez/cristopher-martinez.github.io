---
import { langFromPath, useTranslations } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const live = [
  { host: 'velocityanime.com', href: 'https://velocityanime.com' },
  { host: 'istemp.xyz', href: 'https://istemp.xyz' },
];

const gpuStats = [
  { value: '32', label: t('work.files') },
  { value: '0', label: t('work.deps') },
  { value: '11', label: t('work.tests') },
];
---

<main id="content" class="wrap">
  <section class="hero">
    <p class="label">{t('home.eyebrow')}</p>
    <h1>Cristopher Martinez</h1>
    <p class="role muted">{t('site.role')}</p>
    <p class="pitch muted">{t('home.pitch')}</p>

    <ul class="live" aria-label={t('live.label')}>
      {
        live.map((site) => (
          <li>
            <a class="live-chip mono" href={site.href} rel="noopener">
              {site.host}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="label">{t('nav.work')}</h2>
    <article class="card">
      <h3>velocitygpu</h3>
      <p class="muted">{t('work.gpu.body')}</p>
      <dl class="stats mono">
        {
          gpuStats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </article>
  </section>
</main>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero .label {
    margin-block-end: var(--space-m);
  }

  .role {
    font-size: var(--step-0);
    margin-block-start: var(--space-2xs);
  }

  .pitch {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
    margin-block-start: var(--space-m);
  }

  .live {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-l);
  }

  .live-chip {
    font-size: var(--step--1);
    color: var(--signal);
    text-decoration: none;
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding-inline: var(--space-xs);
    gap: var(--space-2xs);
  }

  .live-chip::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  .live-chip:hover {
    background: var(--signal-soft);
  }

  .work {
    padding-block-end: var(--space-2xl);
  }

  /* The section heading exists for document outline more than for display,
     so it takes the label treatment rather than a heading-sized step. */
  .work > .label {
    font-size: var(--step--2);
    font-weight: 500;
    margin-block-end: var(--space-s);
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius);
    padding: var(--space-m);
  }

  .card p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line-soft);
  }

  .stats div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
    flex-direction: row-reverse;
  }

  .stats dt {
    font-size: var(--step--2);
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stats dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink);
  }
</style>
