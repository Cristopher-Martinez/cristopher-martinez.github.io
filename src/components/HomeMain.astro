---
import { getCollection } from 'astro:content';
import { langFromPath, useTranslations, pathForLang } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const projects = (await getCollection('projects'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const log = (await getCollection('bitacora'))
  .filter((e) => e.data.lang === lang && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Formatted in UTC on purpose — see the note in LogEntry.astro. A frontmatter
// date coerces to UTC midnight and would render as the previous day in any
// negative-offset zone.
const dateFormat = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

/** Strips the `<lang>/` prefix the glob loader puts in front of every id. */
const slugOf = (id: string) => id.split('/').pop() ?? id;
---

<main id="content" class="wrap">
  <section class="hero">
    <p class="label">{t('home.eyebrow')}</p>
    <h1>Cristopher Martinez</h1>
    <p class="role muted">{t('site.role')}</p>
    <p class="pitch muted">{t('home.pitch')}</p>
  </section>

  <section class="work" aria-labelledby="work-heading">
    <h2 id="work-heading" class="label">{t('nav.work')}</h2>
    <ul class="cards">
      {
        projects.map((p) => (
          <li class="card">
            <div class="card-top">
              <h3>{p.data.name}</h3>
              {p.data.status === 'live' && p.data.url && (
                <a class="live-chip mono" href={p.data.url} rel="noopener">
                  {new URL(p.data.url).host}
                </a>
              )}
              {p.data.status === 'open' && p.data.repo && (
                <a class="live-chip mono" href={p.data.repo} rel="noopener">
                  {t('work.source')}
                </a>
              )}
            </div>
            <p class="muted">{p.data.summary}</p>
            <ul class="tech mono">
              {p.data.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
            {p.data.stats && (
              <dl class="stats mono">
                {p.data.stats.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd>{s.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="log" aria-labelledby="log-heading">
    <h2 id="log-heading" class="label">{t('nav.log')}</h2>
    <ul class="entries">
      {
        log.map((entry) => (
          <li>
            <a href={pathForLang(`/bitacora/${slugOf(entry.id)}/`, lang)}>
              <time class="mono" datetime={entry.data.date.toISOString()}>
                {dateFormat.format(entry.data.date)}
              </time>
              <span class="entry-title">{entry.data.title}</span>
            </a>
            <p class="muted">{entry.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </section>
</main>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero .label {
    margin-block-end: var(--space-m);
  }

  .role {
    font-size: var(--step-0);
    margin-block-start: var(--space-2xs);
  }

  .pitch {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
    margin-block-start: var(--space-m);
  }

  section[aria-labelledby] {
    padding-block-end: var(--space-xl);
  }

  section > .label {
    display: block;
    font-size: var(--step--2);
    font-weight: 500;
    margin-block-end: var(--space-s);
  }

  .cards,
  .entries,
  .tech {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cards {
    display: grid;
    gap: var(--space-s);
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius);
    padding: var(--space-m);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .card p {
    margin-block-start: var(--space-2xs);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .live-chip {
    font-size: var(--step--2);
    color: var(--signal);
    text-decoration: none;
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding-inline: var(--space-xs);
    gap: var(--space-2xs);
  }

  .live-chip::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  .live-chip:hover {
    background: var(--signal-soft);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-s);
    font-size: var(--step--2);
    color: var(--ink-dim);
  }

  .tech li::after {
    content: '·';
    margin-inline-start: var(--space-2xs);
  }

  .tech li:last-child::after {
    content: '';
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line-soft);
  }

  .stats div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
    flex-direction: row-reverse;
  }

  .stats dt {
    font-size: var(--step--2);
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stats dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .entries {
    display: grid;
    gap: var(--space-m);
  }

  .entries a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs);
    text-decoration: none;
    min-height: 0;
  }

  .entries time {
    font-size: var(--step--2);
    color: var(--ink-dim);
    flex: none;
  }

  .entry-title {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
  }

  .entries a:hover .entry-title {
    text-decoration-color: var(--signal);
  }

  .entries p {
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    line-height: 1.6;
  }
</style>
