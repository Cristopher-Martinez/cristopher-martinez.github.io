---
import {
  languages,
  localeTags,
  langFromPath,
  routeWithoutLang,
  pathForLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

const current: Lang = langFromPath(Astro.url.pathname);
// The 404 page has no translated twin, so there the switcher falls back to the
// other language's home page instead of pointing at a page that does not exist.
const route = routeWithoutLang(Astro.url.pathname) === '/404/' ? '/' : routeWithoutLang(Astro.url.pathname);
const t = useTranslations(current);

// Link to the same page in the other language, not to the home page — sending
// readers back to the root on every switch is the classic i18n annoyance.
const others = (Object.keys(languages) as Lang[]).filter((code) => code !== current);
---

<nav aria-label={t('lang.switch')}>
  {
    others.map((code) => (
      <a
        class="lang-link"
        href={pathForLang(route, code)}
        hreflang={localeTags[code]}
        lang={localeTags[code]}
      >
        {localeTags[code].toUpperCase()}
      </a>
    ))
  }
</nav>

<style>
  .lang-link {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding-inline: var(--space-2xs);
    min-width: 44px;
    justify-content: center;
  }

  .lang-link:hover {
    color: var(--signal);
    border-color: var(--signal);
  }
</style>
