---
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, pathForLang, type Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'bitacora'>;
}

const { entry } = Astro.props;
const lang = entry.data.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);

// A frontmatter date is a calendar date, not an instant. Coercion parses it as
// UTC midnight, so formatting it in a negative-offset local zone renders the
// previous day. Formatting in UTC makes the page show the date as written.
const dateFormat = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<main id="content" class="wrap entry">
  <article>
    <header>
      <time class="label" datetime={entry.data.date.toISOString()}>
        {dateFormat.format(entry.data.date)}
      </time>
      <h1>{entry.data.title}</h1>
      <p class="summary muted">{entry.data.summary}</p>

      <aside class="outcome">
        <p class="outcome-label mono">{t('log.outcome')}</p>
        <p>{entry.data.outcome}</p>
      </aside>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <a class="back" href={pathForLang('/bitacora/', lang)}>{t('log.back')}</a>
</main>

<style>
  .entry {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-start: var(--space-xs);
  }

  .summary {
    font-size: var(--step-0);
    line-height: 1.6;
    margin-block-start: var(--space-s);
    max-width: 54ch;
  }

  /*
   * The measured result sits above the narrative on purpose. An engineering log
   * whose entries stop at "and then I built it" reads as marketing.
   */
  .outcome {
    margin-block-start: var(--space-m);
    padding: var(--space-s);
    background: var(--signal-soft);
    border-inline-start: 2px solid var(--signal);
    border-radius: var(--radius);
  }

  .outcome-label {
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal-ink);
    margin-block-end: var(--space-3xs);
  }

  .outcome p:last-child {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink);
    max-width: 60ch;
  }

  .prose {
    margin-block-start: var(--space-l);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-size: var(--step--1);
  }
</style>
