---
import { getCollection } from 'astro:content';
import { langFromPath, useTranslations, pathForLang } from '../i18n/ui';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const entries = (await getCollection('bitacora'))
  .filter((e) => e.data.lang === lang && !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Formatted in UTC: a frontmatter date coerces to UTC midnight and would render
// as the previous day in any negative-offset zone.
const dateFormat = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const slugOf = (id: string) => id.split('/').pop() ?? id;
---

<main id="content" class="wrap log-index">
  <header>
    <p class="label">{t('nav.log')}</p>
    <h1>{t('log.title')}</h1>
    <p class="intro muted">{t('log.intro')}</p>
  </header>

  <ol class="entries">
    {
      entries.map((entry) => (
        <li>
          <article>
            <time class="mono" datetime={entry.data.date.toISOString()}>
              {dateFormat.format(entry.data.date)}
            </time>
            <h2>
              <a href={pathForLang(`/bitacora/${slugOf(entry.id)}/`, lang)}>{entry.data.title}</a>
            </h2>
            <p class="muted">{entry.data.summary}</p>
            <p class="outcome">
              <span class="mono outcome-label">{t('log.outcome')}</span>
              {entry.data.outcome}
            </p>
          </article>
        </li>
      ))
    }
  </ol>
</main>

<style>
  .log-index {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-start: var(--space-xs);
  }

  .intro {
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 54ch;
    margin-block-start: var(--space-s);
  }

  .entries {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-l);
  }

  .entries li {
    border-block-start: 1px solid var(--line);
    padding-block-start: var(--space-m);
  }

  time {
    font-size: var(--step--2);
    color: var(--ink-dim);
  }

  h2 {
    font-size: var(--step-1);
    margin-block-start: var(--space-3xs);
  }

  h2 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.22em;
    min-height: 0;
    display: inline;
  }

  h2 a:hover {
    text-decoration-color: var(--signal);
  }

  article p {
    font-size: var(--step--1);
    line-height: 1.6;
    margin-block-start: var(--space-2xs);
  }

  .outcome {
    color: var(--ink);
    border-inline-start: 2px solid var(--signal);
    padding-inline-start: var(--space-xs);
    margin-block-start: var(--space-s);
  }

  .outcome-label {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    display: block;
  }
</style>
