---
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, pathForLang, type Lang } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const lang = entry.data.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);
---

<main id="content" class="wrap detail">
  <article>
    <header>
      <p class="label">{t('nav.work')}</p>
      <h1>{entry.data.name}</h1>
      <p class="summary muted">{entry.data.summary}</p>

      <div class="links">
        {
          entry.data.url && (
            <a class="chip mono live" href={entry.data.url} rel="noopener">
              {t('live.label')} · {new URL(entry.data.url).host}
            </a>
          )
        }
        {
          entry.data.repo && (
            <a class="chip mono" href={entry.data.repo} rel="noopener">
              {t('work.source')}
            </a>
          )
        }
      </div>

      <ul class="tech mono">
        {entry.data.stack.map((tech) => <li>{tech}</li>)}
      </ul>

      {
        entry.data.stats && (
          <dl class="stats mono">
            {entry.data.stats.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <a class="back" href={pathForLang('/', lang)}>{t('work.back')}</a>
</main>

<style>
  .detail {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  h1 {
    font-size: var(--step-3);
    margin-block-start: var(--space-xs);
  }

  .summary {
    font-size: var(--step-0);
    line-height: 1.6;
    margin-block-start: var(--space-s);
    max-width: 54ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-start: var(--space-m);
  }

  .chip {
    font-size: var(--step--2);
    color: var(--signal);
    text-decoration: none;
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding-inline: var(--space-xs);
    gap: var(--space-2xs);
  }

  .chip.live::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    border-radius: 50%;
    background: var(--signal);
    flex: none;
  }

  .chip:hover {
    background: var(--signal-soft);
  }

  .tech {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-size: var(--step--2);
    color: var(--ink-dim);
  }

  .tech li::after {
    content: '·';
    margin-inline-start: var(--space-2xs);
  }

  .tech li:last-child::after {
    content: '';
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-xs);
    border-block-start: 1px solid var(--line-soft);
  }

  .stats div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
    flex-direction: row-reverse;
  }

  .stats dt {
    font-size: var(--step--2);
    color: var(--ink-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stats dd {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .prose {
    margin-block-start: var(--space-l);
  }

  .back {
    margin-block-start: var(--space-xl);
    font-size: var(--step--1);
  }
</style>
