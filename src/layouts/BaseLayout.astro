---
import '../styles/base.css';
// `?url` hands back the hashed build path, which is the only way to preload an
// asset whose filename is decided at build time.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import {
  languages,
  localeTags,
  defaultLang,
  langFromPath,
  routeWithoutLang,
  pathForLang,
  useTranslations,
  type Lang,
} from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Path to a social preview image, relative to the site root. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const lang: Lang = langFromPath(Astro.url.pathname);
const route = routeWithoutLang(Astro.url.pathname);
const t = useTranslations(lang);

// Astro.site comes from `site` in astro.config.mjs. Social crawlers and
// hreflang annotations both reject relative URLs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;

// Without these, search engines treat the two language versions as duplicate
// content and pick one on their own — usually not the one you wanted.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  hreflang: localeTags[code],
  href: new URL(pathForLang(route, code), Astro.site).href,
}));
const xDefault = new URL(pathForLang(route, defaultLang), Astro.site).href;
---

<html lang={localeTags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Runs before first paint so a stored theme choice never flashes the other
      theme first. It must stay inline and in <head>; an external or deferred
      script is already too late.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {}
    </script>

    {/*
      Only the display face is preloaded: it renders the h1, which is the LCP
      element on every page. The mono face carries small labels and can swap in
      late without moving the metric. `crossorigin` is required even same-origin
      — without it the preload is discarded and the font is fetched twice.
    */}
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={localeTags[lang]} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#content">{t('skip.content')}</a>
    <slot />
  </body>
</html>
