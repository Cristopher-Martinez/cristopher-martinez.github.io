---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

// A static host serves one 404 for every path, so this page cannot know which
// language the reader was in. It offers both rather than guessing.
---

<BaseLayout title="404 — Cristopher Martinez" description="Page not found.">
  <SiteHeader />
  <main id="content" class="wrap missing">
    <p class="label mono">404</p>
    <h1>Not here. / No está acá.</h1>
    <p class="muted">
      The page moved or never existed. The home page has everything that does.
    </p>
    <p class="muted">La página se movió o nunca existió. El inicio tiene todo lo que sí.</p>
    <ul class="ways">
      <li><a href="/">Home</a></li>
      <li><a href="/es/">Inicio</a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  .missing {
    padding-block: var(--space-2xl);
    min-height: 50dvh;
  }

  h1 {
    font-size: var(--step-3);
    margin-block: var(--space-xs) var(--space-s);
  }

  .missing p {
    font-size: var(--step-0);
  }

  .ways {
    list-style: none;
    padding: 0;
    margin: var(--space-m) 0 0;
    display: flex;
    gap: var(--space-s);
  }

  .ways a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    padding-inline: var(--space-xs);
    text-decoration: none;
  }

  .ways a:hover {
    background: var(--signal-soft);
  }
</style>
