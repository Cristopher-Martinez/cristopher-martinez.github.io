---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import LogEntry from '../../../components/LogEntry.astro';

export async function getStaticPaths() {
  const entries = await getCollection('bitacora');
  return entries
    .filter((entry) => entry.data.lang === 'es' && !entry.data.draft)
    .map((entry) => ({
      // The glob loader prefixes ids with `<lang>/`; the route wants the slug.
      params: { slug: entry.id.split('/').pop()! },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'bitacora'> };
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <SiteHeader />
  <LogEntry entry={entry} />
</BaseLayout>
